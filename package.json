{
  "name": "batyskaf-web",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "server": "tsx server/index.ts",
    "assets:data": "python tools/prepare_data.py",
    "mock-arm": "tsx tools/mock_arm.ts",
    "format": "prettier --write src server tests tools/*.ts tools/*.mjs *.ts *.json index.html README.md docs public/models/SOURCES.md",
    "format:check": "prettier --check src server tests tools/*.ts tools/*.mjs *.ts *.json index.html README.md docs public/models/SOURCES.md",
    "measure": "node tools/measure.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.1",
    "@babylonjs/loaders": "^9.32.1",
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
